{
  "name": "ragdoll-fling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "typecheck": "tsc && tsc -p worker",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "approve": "node scripts/approve-production.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/matter-js": "^0.20.2",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
