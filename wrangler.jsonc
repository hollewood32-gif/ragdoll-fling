// Cloudflare Workers configuration ("infrastructure as code").
// `wrangler deploy` reads this file and makes Cloudflare match it.
//
// Two environments:
//   production (the top level)  -> Worker "fling"         at fling.jeffreydoughty.com
//   staging    (env.staging)    -> Worker "fling-staging" at fling-staging.jeffreydoughty.com
// Deploy staging with `wrangler deploy --env staging`.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Which Cloudflare account to deploy to. An ID, not a secret.
  "account_id": "1fffec26e09010f5be9bf9332b2b8e03",

  // The production Worker's name in the Cloudflare account.
  "name": "fling",

  // Locks in which version of the Workers runtime behavior we get,
  // so a Cloudflare update can't silently change how the site runs.
  "compatibility_date": "2026-11-01",

  // Server code for the leaderboard API (worker/index.ts).
  "main": "./worker/index.ts",

  // The game itself is static files that Vite builds into dist/. Requests are
  // served straight from those files, except /api/*, which runs the code above.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The leaderboard database. The code reaches it as env.DB. Migrations in
  // migrations/ are applied by the pipeline before each deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fling-scores",
      "database_id": "ad225ebb-634e-4b50-8cb4-1a63bd42fa89",
      "migrations_dir": "migrations"
    }
  ],

  // Production keeps its backup address https://fling.ragdoll-fling.workers.dev,
  // but doesn't make per-version preview links (those belong to staging).
  "workers_dev": true,
  "preview_urls": false,

  // Serve production on our own subdomain. Because jeffreydoughty.com's DNS is on
  // Cloudflare, deploying creates the DNS record and HTTPS certificate for us.
  "routes": [
    { "pattern": "fling.jeffreydoughty.com", "custom_domain": true }
  ],

  "env": {
    "staging": {
      // Wrangler names this Worker "fling-staging" automatically.
      "workers_dev": true,

      // Each pull request uploads a version here with its own preview link,
      // like https://pr-4-fling-staging.ragdoll-fling.workers.dev
      "preview_urls": true,

      "routes": [
        { "pattern": "fling-staging.jeffreydoughty.com", "custom_domain": true }
      ],

      // Staging has its own database, so testing can never touch real scores.
      // (Each environment must list its databases; they aren't inherited.)
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fling-scores-staging",
          "database_id": "2423c963-2185-439f-a114-0748d8af0c40",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
